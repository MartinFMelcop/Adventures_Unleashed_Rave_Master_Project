+function normalizePatchText(patchText) {
+  let p = String(patchText || "");
+  // Remove BOM + normaliza quebras de linha (git apply no Linux espera \n)
+  p = p.replace(/^\uFEFF/, "");
+  p = p.replace(/\r\n/g, "\n").replace(/\r/g, "\n");
+
+  // Remove fences ```diff (quando o modelo desobedece o contrato)
+  p = p.replace(/^```(?:diff)?\s*\n/, "");
+  p = p.replace(/\n```\s*$/, "");
+
+  // Garante newline final
+  p = p.trim() + "\n";
+
+  // Mantém somente a partir do primeiro diff --git (descarta texto antes)
+  const first = p.indexOf("diff --git ");
+  if (first > 0) p = p.slice(first);
+
+  return p;
+}
+
+function stripNonDiffLines(patchText) {
+  const p = normalizePatchText(patchText);
+  const lines = p.split("\n");
+
+  const okMeta = (line) =>
+    line === "" ||
+    line.startsWith("diff --git ") ||
+    line.startsWith("index ") ||
+    line.startsWith("--- ") ||
+    line.startsWith("+++ ") ||
+    line.startsWith("@@ ") ||
+    line.startsWith("new file mode ") ||
+    line.startsWith("deleted file mode ") ||
+    line.startsWith("old mode ") ||
+    line.startsWith("new mode ") ||
+    line.startsWith("similarity index ") ||
+    line.startsWith("rename from ") ||
+    line.startsWith("rename to ") ||
+    line.startsWith("copy from ") ||
+    line.startsWith("copy to ") ||
+    line.startsWith("Binary files ") ||
+    line.startsWith(" ") ||
+    line.startsWith("+") ||
+    line.startsWith("-") ||
+    line.startsWith("\\"); // \ No newline at end of file
+
+  const out = [];
+  let started = false;
+  for (const line of lines) {
+    if (!started) {
+      if (line.startsWith("diff --git ")) started = true;
+      else continue;
+    }
+    if (okMeta(line)) out.push(line);
+  }
+
+  return out.join("\n").trim() + "\n";
+}
+
+function patchSnippetAroundLine(patchText, lineNo, radius = 6) {
+  const lines = String(patchText || "").split("\n");
+  const n = Math.max(1, Number(lineNo) || 1);
+  const start = Math.max(1, n - radius);
+  const end = Math.min(lines.length, n + radius);
+  const out = [];
+  for (let i = start; i <= end; i++) {
+    out.push(`${String(i).padStart(4, " ")}: ${lines[i - 1] ?? ""}`);
+  }
+  return out.join("\n");
+}
+
+function buildApplyFeedback(errMsg, patchText) {
+  const msg = String(errMsg || "");
+  const m = msg.match(/line\s+(\d+)/i);
+  if (!m) return msg;
+  const lineNo = Number(m[1]);
+  return `${msg}\n\nTrecho do patch ao redor da linha ${lineNo}:\n${patchSnippetAroundLine(patchText, lineNo)}`;
+}
